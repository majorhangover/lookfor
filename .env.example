# Claude API key (https://console.anthropic.com). Without it, the app runs in demo mode.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-haiku-5-5)
CHAT_MODEL=

# Amazon Associates tracking IDs
AMAZON_TAG_UK=lookfor-21
AMAZON_TAG_US=

# Optional: ElevenLabs voices. Without them, the browser's voice is used.
ELEVENLABS_API_KEY=
# Default voice for every character, overridden per character below
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_SANTA=
ELEVENLABS_VOICE_BEAR=
ELEVENLABS_VOICE_BUNNY=
ELEVENLABS_VOICE_CUPID=
ELEVENLABS_VOICE_LOU=
# Optional: how fast the characters talk, from 0.7 (slower) to 1.2 (faster). Default 1.0
ELEVENLABS_SPEED=

# Optional: accounts and saved lists (Supabase > Project Settings > API).
# Without these, sign-in is hidden and lists stay on the visitor's device.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
